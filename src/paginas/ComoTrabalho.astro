---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Secao from '~/components/Secao.astro';
import Foto from '~/components/Foto.astro';
import ChamadaFinal from '~/components/ChamadaFinal.astro';

import { CONTATO, IDIOMAS_FALADOS, TAG_IDIOMA_FALADO, SITE } from '~/config/site';
import { imagem, fotoOlivia } from '~/lib/imagens';
import { dicionario, type Idioma } from '~/i18n/config';

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const t = dicionario(lang);

const retrato = fotoOlivia();
const fotoEquipe = imagem('fotos', 'equipe');

// Os idiomas do atendimento sao os da equipe inteira, nao so os do site.
const idiomasFalados = IDIOMAS_FALADOS.map((codigo) => t.idiomasFalados[codigo]).join(', ');

// A pagina apresenta quem conduz o trabalho: vale declarar a pessoa por tras do negocio.
const schemaPessoa = {
  '@type': 'Person',
  '@id': `${SITE.url}/#olivia`,
  name: SITE.autora,
  jobTitle: t.home.hero.sobretitulo,
  worksFor: { '@id': `${SITE.url}/#negocio` },
  knowsLanguage: IDIOMAS_FALADOS.map((codigo) => TAG_IDIOMA_FALADO[codigo]),
};
---

<BaseLayout
  lang={lang}
  titulo={t.meta.comoTrabalho.titulo}
  descricao={t.meta.comoTrabalho.descricao}
  secaoAtiva="comoTrabalho"
  schemaExtra={[schemaPessoa]}
>
  <!-- --------------------------------------------------------- Abertura -->
  <section class="bg-nevoa pb-20 pt-14 md:pb-28 md:pt-20">
    <div class="container-site">
      <div class="grid items-end gap-12 md:grid-cols-[1.1fr_1fr] md:gap-16">
        <div class="revelar">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-pedra">
            {t.comoTrabalho.sobretitulo}
          </p>
          <h1 class="mt-4 text-titulo-pagina text-balance text-atlantico">
            {t.comoTrabalho.titulo}
          </h1>
          <div class="prosa mt-8">
            <p class="text-pedra">{t.comoTrabalho.p1}</p>
            <p class="text-pedra">{t.comoTrabalho.p2}</p>
            <p class="text-pedra">{t.comoTrabalho.p3}</p>
          </div>
        </div>

        <div class="revelar">
          <Foto
            src={retrato}
            alt={`${SITE.autora}, ${t.home.hero.sobretitulo}`}
            proporcao="4 / 5"
            sizes="(min-width: 768px) 42vw, 100vw"
            class="rounded-sm"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------------ Equipe -->
  <Secao>
    <div class="grid items-center gap-12 md:grid-cols-2 md:gap-16">
      {/* Sem foto da equipe, o bloco fica so com o texto, sem espaco reservado.
          Basta soltar src/assets/fotos/equipe.jpg para a foto voltar. */}
      {
        fotoEquipe && (
          <div class="revelar">
            <Foto
              src={fotoEquipe}
              alt={t.comoTrabalho.equipe.titulo}
              proporcao="3 / 2"
              sizes="(min-width: 768px) 48vw, 100vw"
              class="rounded-sm"
            />
          </div>
        )
      }

      <div class="revelar">
        <h2 class="text-titulo-secao text-balance text-atlantico">
          {t.comoTrabalho.equipe.titulo}
        </h2>
        <div class="prosa mt-7">
          <p class="text-pedra">{t.comoTrabalho.equipe.p1}</p>
          <p class="text-pedra">{t.comoTrabalho.equipe.p2}</p>
          <p class="text-pedra">{t.comoTrabalho.equipe.p3}</p>
        </div>
      </div>
    </div>
  </Secao>

  <!-- --------------------------------------------- Estrutura e credenciais -->
  <Secao fundo="nevoa">
    <div class="grid gap-14 md:grid-cols-2 md:gap-16">
      <div class="revelar">
        <h2 class="text-titulo-secao text-balance text-atlantico">
          {t.comoTrabalho.estrutura.titulo}
        </h2>
        <p class="mt-6 max-w-md text-pretty text-pedra">{t.comoTrabalho.estrutura.texto}</p>
      </div>

      <div class="revelar">
        <h2 class="text-titulo-secao text-atlantico">{t.comoTrabalho.credenciais.titulo}</h2>

        <dl class="mt-7 divide-y divide-atlantico/10 border-y border-atlantico/10">
          <div class="flex items-baseline justify-between gap-6 py-4">
            <dt class="text-sm text-pedra">{t.comoTrabalho.credenciais.experiencia}</dt>
            <dd class="font-titulo text-3xl text-atlantico">{SITE.anosDeExperiencia}+</dd>
          </div>

          <div class="flex items-baseline justify-between gap-6 py-4">
            <dt class="text-sm text-pedra">{t.comoTrabalho.credenciais.idiomas}</dt>
            <dd class="text-right text-sm font-medium text-atlantico">{idiomasFalados}</dd>
          </div>

          <div class="flex items-baseline justify-between gap-6 py-4">
            <dt class="text-sm text-pedra">
              {CONTATO.cadastur
                ? t.comoTrabalho.credenciais.cadastur
                : t.comoTrabalho.credenciais.cadasturSemNumero}
            </dt>
            {
              CONTATO.cadastur && (
                <dd class="text-right text-sm font-medium text-atlantico">{CONTATO.cadastur}</dd>
              )
            }
          </div>
        </dl>
      </div>
    </div>
  </Secao>

  <ChamadaFinal lang={lang} />
</BaseLayout>
