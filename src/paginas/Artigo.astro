---
import { render } from 'astro:content';

import BaseLayout from '~/layouts/BaseLayout.astro';
import Foto from '~/components/Foto.astro';
import CartaoArtigo from '~/components/CartaoArtigo.astro';
import ChamadaFinal from '~/components/ChamadaFinal.astro';
import Icone from '~/components/Icone.astro';

import { SITE } from '~/config/site';
import { imagem } from '~/lib/imagens';
import { alternativasDoArtigo, artigosDe, minutosDeLeitura, type Artigo } from '~/lib/dicas';
import { LOCALE_DATA, dicionario, rota, TAG_HREFLANG, type Idioma } from '~/i18n/config';

interface Props {
  artigo: Artigo;
  lang: Idioma;
}

const { artigo, lang } = Astro.props;
const t = dicionario(lang);

const { Content } = await render(artigo);

const foto = imagem('artigos', artigo.data.imagem);
const alternativas = await alternativasDoArtigo(artigo.data.chave);

const outros = (await artigosDe(lang))
  .filter((outro) => outro.data.chave !== artigo.data.chave)
  .slice(0, 3);

const minutos = minutosDeLeitura(artigo.body);

const dataLonga = artigo.data.data.toLocaleDateString(LOCALE_DATA[lang], {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const schemaArtigo = {
  '@type': 'Article',
  headline: artigo.data.titulo,
  description: artigo.data.resumo,
  datePublished: artigo.data.data.toISOString(),
  inLanguage: TAG_HREFLANG[lang],
  author: { '@type': 'Person', name: SITE.autora },
  publisher: { '@id': `${SITE.url}/#negocio` },
  mainEntityOfPage: new URL(Astro.url.pathname, SITE.url).href,
};
---

<BaseLayout
  lang={lang}
  titulo={artigo.data.titulo}
  descricao={artigo.data.resumo}
  secaoAtiva="dicas"
  alternativas={alternativas}
  tipoOg="article"
  schemaExtra={[schemaArtigo]}
>
  <article>
    <!-- ------------------------------------------------------- Abertura -->
    <header class="bg-nevoa pb-16 pt-14 md:pb-20 md:pt-20">
      <div class="container-site">
        <a
          href={rota('dicas', lang)}
          class="inline-flex items-center gap-2 text-sm text-pedra transition-colors
                 duration-200 hover:text-atlantico"
        >
          <Icone nome="seta" tamanho={16} class="rotate-180" />
          {t.dicas.sobretitulo}
        </a>

        <h1 class="mt-7 max-w-3xl text-titulo-pagina text-balance text-atlantico">
          {artigo.data.titulo}
        </h1>

        <p class="mt-6 max-w-xl text-pretty text-pedra">{artigo.data.resumo}</p>

        <p class="mt-7 text-xs uppercase tracking-[0.12em] text-pedra">
          <time datetime={artigo.data.data.toISOString()}>{dataLonga}</time>
          <span aria-hidden="true"> · </span>
          {minutos} {t.dicas.leituraMin}
        </p>
      </div>
    </header>

    <div class="container-site">
      <div class="-mt-8 md:-mt-12">
        <Foto
          src={foto}
          alt={artigo.data.alt ?? artigo.data.titulo}
          proporcao="16 / 9"
          larguras={[640, 960, 1400, 1920]}
          sizes="(min-width: 1280px) 76rem, 100vw"
          class="rounded-sm"
        />
      </div>

      <div class="artigo mx-auto mt-14 md:mt-20">
        <Content />
      </div>

      <!-- ------------------------------------------------ Chamada no fim -->
      <div class="mx-auto mt-16 max-w-[38rem] border-t border-nevoa-forte pt-10">
        <h2 class="text-titulo-cartao text-atlantico">{t.dicas.ctaTitulo}</h2>
        <p class="mt-3 text-sm leading-relaxed text-pedra">{t.dicas.ctaTexto}</p>
      </div>
    </div>

    <!-- --------------------------------------------------- Outras dicas -->
    {
      outros.length > 0 && (
        <section class="mt-24 bg-nevoa py-20 md:mt-32 md:py-24">
          <div class="container-site">
            <h2 class="revelar text-titulo-secao text-atlantico">{t.dicas.outrasDicas}</h2>

            <div class="mt-12 grid gap-x-7 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
              {outros.map((outro) => (
                <CartaoArtigo artigo={outro} lang={lang} />
              ))}
            </div>
          </div>
        </section>
      )
    }
  </article>

  <ChamadaFinal
    lang={lang}
    mensagem={t.whatsapp.dica.replace('{nome}', artigo.data.titulo)}
  />
</BaseLayout>
