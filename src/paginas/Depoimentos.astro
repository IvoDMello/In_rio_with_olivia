---
import BaseLayout from '~/layouts/BaseLayout.astro';
import CarrosselAvaliacoes from '~/components/CarrosselAvaliacoes.astro';
import ChamadaFinal from '~/components/ChamadaFinal.astro';
import Icone from '~/components/Icone.astro';

import { CONTATO } from '~/config/site';
import { AVALIACOES } from '~/data/reviews';
import { dicionario, type Idioma } from '~/i18n/config';

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const t = dicionario(lang);

// Da mais recente para a mais antiga, pela data, qualquer que seja a ordem
// em que as avaliacoes foram coladas em reviews.ts.
const avaliacoes = [...AVALIACOES].sort((a, b) => b.data.localeCompare(a.data));
---

<BaseLayout
  lang={lang}
  titulo={t.meta.depoimentos.titulo}
  descricao={t.meta.depoimentos.descricao}
  secaoAtiva="depoimentos"
>
  <!--
    Um bloco so em Nevoa, da abertura ao ultimo cartao. Os cartoes sao
    brancos e precisam do fundo claro, e dividir em duas secoes da mesma cor
    so criaria um vao sem motivo.
  -->
  <section class="bg-nevoa pb-20 pt-14 md:pb-28 md:pt-20">
    <div class="container-site">
      <div
        class="revelar flex flex-col gap-8 md:flex-row md:items-end md:justify-between md:gap-12"
      >
        <div class="max-w-2xl">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-pedra">
            {t.depoimentos.sobretitulo}
          </p>
          <h1 class="mt-4 text-titulo-pagina text-balance text-atlantico">
            {t.depoimentos.titulo}
          </h1>
          <p class="mt-6 text-pretty text-pedra">{t.depoimentos.texto}</p>
        </div>

        {
          CONTATO.tripadvisor && (
            <a
              href={CONTATO.tripadvisor}
              target="_blank"
              rel="noopener"
              data-analytics="tripadvisor-depoimentos"
              class="inline-flex shrink-0 items-center gap-2.5 self-start rounded-full border
                     border-atlantico/25 px-6 py-3 text-[0.95rem] text-atlantico
                     transition-colors duration-200 hover:border-sol hover:bg-sol/10
                     md:self-auto"
            >
              <Icone nome="tripadvisor" tamanho={20} />
              {t.botoes.tripadvisor}
            </a>
          )
        }
      </div>

      {
        /*
         * No computador, grade com os cartoes do mesmo tamanho; no celular,
         * carrossel lateral, para nao virar uma fila comprida. Os detalhes
         * estao em CarrosselAvaliacoes.astro.
         */
        avaliacoes.length > 0 && (
          <CarrosselAvaliacoes avaliacoes={avaliacoes} lang={lang} class="mt-14 md:mt-16" />
        )
      }
    </div>
  </section>

  <ChamadaFinal lang={lang} />
</BaseLayout>
