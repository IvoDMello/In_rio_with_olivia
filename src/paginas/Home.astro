---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Secao from '~/components/Secao.astro';
import Foto from '~/components/Foto.astro';
import Icone from '~/components/Icone.astro';
import BotaoWhatsApp from '~/components/BotaoWhatsApp.astro';
import CartaoLugar from '~/components/CartaoLugar.astro';
import CartaoEspecial from '~/components/CartaoEspecial.astro';
import CartaoAvaliacao from '~/components/CartaoAvaliacao.astro';
import CartaoArtigo from '~/components/CartaoArtigo.astro';
import FaixaInstagram from '~/components/FaixaInstagram.astro';
import ChamadaFinal from '~/components/ChamadaFinal.astro';

import { CONTATO, RECURSOS, SITE } from '~/config/site';
import { AVALIACOES } from '~/data/reviews';
import { fotoHero, fotoOlivia } from '~/lib/imagens';
import { especiais as carregaEspeciais, lugares as carregaLugares } from '~/lib/conteudo';
import { artigosDe } from '~/lib/dicas';
import { dicionario, rota, type Idioma } from '~/i18n/config';

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const t = dicionario(lang);

const destaques = (await carregaLugares()).filter((l) => l.data.destaque);
const especiais = await carregaEspeciais();

// Descricao de cada foto, por id. Nem todo lugar tem foto, entao a chave pode faltar.
const altEspecial: Record<string, string | undefined> = t.fotos.especiais;
const artigos = (await artigosDe(lang)).slice(0, 3);

const hero = fotoHero();
const retrato = fotoOlivia();

/**
 * Recorte da foto do hero, o Cristo ao entardecer. A foto e vertical e o Cristo
 * e pequeno nela, enquanto a moldura muda com a tela: 4:5 no celular, 16:10 no
 * tablet e 2:1 no desktop. No celular o recorte desce ate o fim, para a estatua
 * subir acima do texto; do tablet em diante, a faixa visivel fica em torno dela.
 * Trocando a foto, refazer o recorte.
 */
const recorteHero = 'object-[50%_100%] sm:object-[50%_58%] lg:object-[50%_47%]';
---

<BaseLayout
  lang={lang}
  titulo={t.meta.home.titulo}
  descricao={t.meta.home.descricao}
  secaoAtiva="home"
>
  <!-- ----------------------------------------------------------- Hero -->
  <section class="relative isolate">
    <Foto
      src={hero}
      alt={t.fotos.hero}
      classeImagem={recorteHero}
      proporcao="4 / 5"
      prioridade
      reservado="escuro"
      larguras={[640, 960, 1400, 1920, 2400]}
      sizes="100vw"
      class="!aspect-[4/5] sm:!aspect-[16/10] lg:!aspect-[16/8]"
    />

    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-t
             from-atlantico/75 via-atlantico/25 to-atlantico/5"
    >
    </div>

    <div class="absolute inset-x-0 bottom-0">
      <div class="container-site pb-12 md:pb-16 lg:pb-20">
        <div class="max-w-2xl">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-nevoa/85">
            {t.home.hero.sobretitulo}
          </p>
          <h1 class="mt-4 text-titulo-pagina text-balance text-branco">
            {t.home.hero.titulo}
          </h1>
          <p class="mt-5 max-w-lg text-pretty text-nevoa/90">
            {t.home.hero.subtitulo}
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <BotaoWhatsApp
              rotulo={t.botoes.whatsapp}
              mensagem={t.whatsapp.geral}
              variante="claro"
              tamanho="grande"
            />
            <a
              href={rota('experiencias', lang)}
              class="inline-flex items-center gap-2 border-b border-nevoa/50 pb-1 text-[0.95rem]
                     text-nevoa transition-colors duration-200 hover:border-sol hover:text-sol"
            >
              {t.botoes.verExperiencias}
              <Icone nome="seta" tamanho={17} />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- -------------------------------------------------- Quem e a Olivia -->
  <Secao>
    <div class="grid items-center gap-12 md:grid-cols-2 md:gap-16">
      <div class="revelar order-2 md:order-1">
        <h2 class="text-titulo-secao text-balance text-atlantico">
          {t.home.apresentacao.titulo}
        </h2>
        <div class="prosa mt-7">
          <p class="text-pedra">{t.home.apresentacao.p1}</p>
          <p class="text-pedra">{t.home.apresentacao.p2}</p>
        </div>

        <a
          href={rota('comoTrabalho', lang)}
          class="mt-8 inline-flex items-center gap-2 border-b border-sol pb-1 text-[0.95rem]
                 font-medium text-atlantico transition-colors duration-200
                 hover:border-atlantico hover:text-atlantico-claro"
        >
          {t.botoes.comoTrabalho}
          <Icone nome="seta" tamanho={17} />
        </a>
      </div>

      <div class="revelar order-1 md:order-2">
        <Foto
          src={retrato}
          alt={t.fotos.retrato}
          proporcao="4 / 5"
          sizes="(min-width: 768px) 45vw, 100vw"
          class="rounded-sm"
        />
      </div>
    </div>
  </Secao>

  <!-- ------------------------------------------------------ Como funciona -->
  <Secao fundo="nevoa" titulo={t.home.comoFunciona.titulo} espacamento="compacto">
    <ol class="grid gap-10 sm:grid-cols-3 sm:gap-8">
      {
        t.home.comoFunciona.passos.map((passo, i) => (
          <li class="revelar">
            <span
              class="flex h-11 w-11 items-center justify-center rounded-full border
                     border-atlantico/15 font-titulo text-lg text-atlantico"
            >
              {i + 1}
            </span>
            <h3 class="mt-5 text-titulo-cartao text-atlantico">{passo.titulo}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-pedra">{passo.texto}</p>
          </li>
        ))
      }
    </ol>
  </Secao>

  <!-- ------------------------------------------- Inspiracoes para o tour -->
  <Secao
    sobretitulo={t.experiencias.sobretitulo}
    titulo={t.home.inspiracoes.titulo}
    texto={t.home.inspiracoes.texto}
  >
    <div class="grid gap-x-7 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {
        destaques.map((lugar) => (
          <CartaoLugar
            id={lugar.id}
            lang={lang}
            nome={lugar.data[lang].nome}
            resumo={lugar.data[lang].resumo}
          />
        ))
      }
    </div>

    <div class="revelar mt-14 text-center">
      <a
        href={rota('experiencias', lang)}
        class="inline-flex items-center gap-2.5 rounded-full border border-atlantico/25
               px-7 py-3.5 text-[0.95rem] text-atlantico transition-colors duration-200
               hover:border-sol hover:bg-sol/10"
      >
        {t.botoes.verTodas}
        <Icone nome="seta" tamanho={18} />
      </a>
    </div>
  </Secao>

  <!-- ------------------------------------------- Experiencias especiais -->
  <Secao
    fundo="nevoa"
    titulo={t.experiencias.especiais.titulo}
    texto={t.experiencias.especiais.texto}
  >
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        especiais.map((especial) => (
          <CartaoEspecial
            id={especial.id}
            alt={altEspecial[especial.id]}
            nome={especial.data[lang].nome}
            resumo={especial.data[lang].resumo}
            modeloMensagem={t.whatsapp.especial}
            rotuloBotao={t.botoes.consultar}
          />
        ))
      }
    </div>

    <p
      class="revelar mt-12 max-w-2xl border-l-2 border-sol pl-5 text-pretty text-pedra
             md:mt-14"
    >
      {t.experiencias.especiais.fechamento}
    </p>
  </Secao>

  <!-- ------------------------------------------------------ Rio by Night -->
  <Secao fundo="atlantico" espacamento="compacto">
    <div class="grid items-center gap-10 md:grid-cols-[1fr_1.1fr] md:gap-16">
      <div class="revelar">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-sol">
          {t.experiencias.noite.subtitulo}
        </p>
        <h2 class="mt-4 text-titulo-secao text-branco">{t.experiencias.noite.titulo}</h2>
        <p class="mt-5 max-w-md text-pretty text-nevoa/75">{t.experiencias.noite.texto}</p>

        <a
          href={`${rota('experiencias', lang)}#rio-by-night`}
          class="mt-8 inline-flex items-center gap-2 border-b border-nevoa/50 pb-1
                 text-[0.95rem] text-nevoa transition-colors duration-200
                 hover:border-sol hover:text-sol"
        >
          {t.botoes.verNoite}
          <Icone nome="seta" tamanho={17} />
        </a>
      </div>

      <ul class="revelar grid gap-x-8 gap-y-3.5 sm:grid-cols-2">
        {
          t.experiencias.noite.opcoes.map((opcao) => (
            <li class="flex items-start gap-3 text-nevoa/85">
              <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-sol" />
              <span class="text-[0.95rem]">{opcao}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </Secao>

  <!-- -------------------------------------------------------- Avaliacoes -->
  {
    RECURSOS.avaliacoes && AVALIACOES.length > 0 && (
      <Secao
        fundo="nevoa"
        titulo={t.home.avaliacoes.titulo}
        texto={t.home.avaliacoes.texto}
        centralizado
      >
        <div class="grid gap-7 md:grid-cols-3">
          {AVALIACOES.slice(0, 3).map((avaliacao) => (
            <CartaoAvaliacao avaliacao={avaliacao} lang={lang} />
          ))}
        </div>

        {CONTATO.tripadvisor && (
          <div class="revelar mt-12 text-center">
            <a
              href={CONTATO.tripadvisor}
              target="_blank"
              rel="noopener"
              data-analytics="tripadvisor"
              class="inline-flex items-center gap-2 border-b border-sol pb-1 text-[0.95rem]
                     font-medium text-atlantico transition-colors duration-200
                     hover:border-atlantico hover:text-atlantico-claro"
            >
              {t.botoes.tripadvisor}
              <Icone nome="seta" tamanho={17} />
            </a>
          </div>
        )}
      </Secao>
    )
  }

  <!-- ------------------------------------------------------------ Dicas -->
  {
    artigos.length > 0 && (
      <Secao sobretitulo={t.dicas.sobretitulo} titulo={t.dicas.titulo} texto={t.dicas.intro}>
        <div class="grid gap-x-7 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {artigos.map((artigo) => (
            <CartaoArtigo artigo={artigo} lang={lang} />
          ))}
        </div>
      </Secao>
    )
  }

  <!-- -------------------------------------------------------- Instagram -->
  {
    RECURSOS.instagram && (
      <Secao
        fundo="nevoa"
        titulo={t.home.instagram.titulo}
        texto={t.home.instagram.texto}
        centralizado
        espacamento="compacto"
      >
        <FaixaInstagram lang={lang} />
      </Secao>
    )
  }

  <ChamadaFinal lang={lang} />
</BaseLayout>
