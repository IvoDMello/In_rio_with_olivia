---
import Foto from './Foto.astro';
import Icone from './Icone.astro';
import { imagem } from '~/lib/imagens';
import { linkWhatsApp } from '~/config/site';

/**
 * Experiencia especial: helicoptero, asa-delta, show, favela tour, ensaio de
 * escola de samba e futebol.
 * Sao as unicas que a Olivia reserva com parceiros, entao cada cartao leva
 * direto para uma conversa sobre aquela experiencia especifica.
 *
 * Diferente do CartaoLugar, que e aberto sobre o fundo da secao, aqui o
 * cartao e uma peca fechada: foto, texto e acao dentro da mesma moldura.
 * Antes so o texto tinha fundo branco e a foto ficava fora dele, o que
 * desenhava um retangulo solto embaixo de cada imagem, com o texto colado
 * na borda. A moldura resolve os dois problemas de uma vez. A borda fina
 * em Atlantico existe para o cartao continuar visivel quando a secao vem
 * com fundo branco, que acontece na pagina de Experiencias.
 */
interface Props {
  id: string;
  nome: string;
  resumo: string;
  /** Descricao da foto. Sem ela, o nome do lugar faz as vezes. */
  alt?: string;
  /** Modelo de mensagem com {nome} no lugar do nome da experiencia. */
  modeloMensagem: string;
  rotuloBotao: string;
}

const { id, nome, resumo, alt, modeloMensagem, rotuloBotao } = Astro.props;
const foto = imagem('especiais', id);
const href = linkWhatsApp(modeloMensagem.replace('{nome}', nome));
---

<article
  class="revelar group flex h-full flex-col overflow-hidden rounded-xl border
         border-atlantico/10 bg-branco transition-[border-color,box-shadow]
         duration-300 hover:border-atlantico/20
         hover:shadow-[0_18px_40px_-24px_rgba(18,58,69,0.35)]"
>
  <Foto
    src={foto}
    alt={alt ?? nome}
    proporcao="3 / 2"
    sizes="(min-width: 1024px) 31vw, (min-width: 640px) 45vw, 100vw"
    classeImagem="transition-transform duration-700 ease-[cubic-bezier(0.2,0,0,1)] motion-safe:group-hover:scale-[1.04]"
  />

  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-titulo-cartao text-atlantico">{nome}</h3>
    <p class="mt-2.5 flex-1 text-sm leading-relaxed text-pedra">{resumo}</p>

    {
      href && (
        <a
          href={href}
          target="_blank"
          rel="noopener"
          data-analytics="whatsapp-especial"
          class="mt-6 inline-flex items-center gap-2 self-start text-sm font-medium
                 text-atlantico underline decoration-transparent
                 underline-offset-4 transition-colors duration-200
                 hover:text-atlantico-claro hover:decoration-sol"
        >
          <Icone nome="whatsapp" tamanho={16} />
          <span>{rotuloBotao}</span>
        </a>
      )
    }
  </div>
</article>
