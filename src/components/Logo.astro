---
/**
 * Logo em SVG embutido, e nao como <img src>.
 *
 * O motivo e a tipografia: a palavra "Olivia" usa Lora, a fonte de titulo do
 * site. Um SVG carregado por <img> roda isolado e nao enxerga as fontes da
 * pagina, entao cairia sempre no Georgia. Embutido, ele usa a fonte que o
 * site ja carregou.
 *
 * SOBRE AS PROPORCOES
 * A altura desenhada na tela e dividida pela altura da viewBox, entao toda
 * margem vazia dentro da viewBox rouba tamanho das letras. Aqui a caixa esta
 * apertada em volta do desenho (120 de altura, sem sobra), e o simbolo foi
 * reduzido para 88 por cento, para o bloco de texto ocupar mais da altura.
 *
 * Os corpos nao sao arbitrarios. Medidos com as fontes reais:
 *   Lora 500 em 68        "Olivia"      183,1 de avanco, altura de O 49,8
 *   Manrope 400 em 29     "in Rio with" 135,7 natural, + 4,34 de tracking
 * O tracking existe para as duas linhas fecharem juntas na direita, em 305,1:
 * a de baixo comeca em 122, a de cima em 126, e a diferenca compensa a lateral
 * do O serifado. O tracking nao conta depois da ultima letra, entao o calculo
 * usa 10 intervalos, nao 11. As linhas de base em 42 e 100 deixam o bloco
 * centrado na caixa (centro em 60,1) com a mesma folga de antes entre as duas.
 *
 * Ao trocar qualquer uma das duas fontes, meca de novo: Lora e cerca de 35 por
 * cento mais larga que a Instrument Serif que estava aqui antes, e foi por isso
 * que a caixa passou de 278 para 307 de largura.
 *
 * Os arquivos em /public/brand seguem as mesmas medidas, para uso fora do
 * site (assinatura de e-mail, TripAdvisor, redes).
 */
interface Props {
  /** 'escura' inverte as cores para uso sobre fundo Atlantico. */
  variante?: 'clara' | 'escura';
  /** Apenas o simbolo, sem a palavra. */
  simbolo?: boolean;
  /** Altura em pixels. A largura acompanha. */
  altura?: number;
  class?: string;
}

const { variante = 'clara', simbolo = false, altura = 48, class: classe = '' } = Astro.props;

const escura = variante === 'escura';
const corTexto = escura ? '#FFFFFF' : '#123A45';
const corSobretitulo = escura ? '#EEF2F0' : '#6B7775';
const corTraco = escura ? '#EEF2F0' : '#123A45';
const corFundo = escura ? '#1C5060' : '#EEF2F0';

const viewBox = simbolo ? '0 0 120 120' : '0 0 307 120';
const largura = simbolo ? altura : Math.round((altura * 307) / 120);
---

<svg
  width={largura}
  height={altura}
  viewBox={viewBox}
  class={classe}
  role="img"
  aria-label="in Rio with Olivia"
  focusable="false"
>
  <g transform={simbolo ? undefined : 'translate(0, 7.2) scale(0.88)'}>
    <circle cx="60" cy="60" r="58" fill={corFundo}></circle>
    <circle cx="40" cy="42" r="7" fill="#E9A23B"></circle>
    <path
      d="M14 84 C 24 72, 34 70, 44 78 C 50 58, 60 32, 76 32 C 92 32, 100 58, 106 84"
      fill="none"
      stroke={corTraco}
      stroke-width="4"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
    <path
      d="M22 94 q 6 -5 12 0 t 12 0 t 12 0 t 12 0 t 12 0 t 12 0"
      fill="none"
      stroke={corTraco}
      stroke-width="3"
      stroke-linecap="round"></path>
  </g>

  {
    !simbolo && (
      <>
        <text
          x="126"
          y="42"
          fill={corSobretitulo}
          font-family="var(--font-texto)"
          font-size="29"
          letter-spacing="4.34"
        >
          in Rio with
        </text>
        <text
          x="122"
          y="100"
          fill={corTexto}
          font-family="var(--font-titulo)"
          font-weight="500"
          font-size="68"
        >
          Olivia
        </text>
      </>
    )
  }
</svg>
