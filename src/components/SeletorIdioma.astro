---
import Bandeira from './Bandeira.astro';
import Icone from './Icone.astro';
import { IDIOMAS, NOME_IDIOMA, dicionario, type Idioma } from '~/i18n/config';

/**
 * Seletor de idioma, com bandeira em vez de sigla.
 *
 * Duas formas, a mesma lista por tras:
 *
 * - `menu` (cabecalho): um botao com a bandeira do idioma atual que abre as
 *   tres opcoes com o nome de cada idioma. Ocupa a largura de um botao
 *   redondo, entao cabe no cabecalho tambem em 360px, onde as tres siglas
 *   lado a lado nao cabiam e o seletor ficava escondido no menu lateral.
 *   E um `<details>` de proposito: abre, fecha, anda pelo teclado e funciona
 *   sem JavaScript. O script so acrescenta fechar com Escape ou com um clique
 *   fora, que o elemento nativo nao faz.
 *
 * - `lista` (painel lateral do celular): uma linha com o idioma atual que,
 *   ao ser tocada, abre os outros dois logo abaixo. As tres opcoes sempre
 *   abertas ocupavam tanto espaco que o ultimo item do menu ficava cortado.
 *
 * O clique tambem grava a escolha, que e o que a raiz do site le na proxima
 * visita para nao perguntar de novo.
 */
interface Props {
  lang: Idioma;
  /** URL equivalente da pagina atual em cada idioma. */
  alternativas: { lang: Idioma; href: string }[];
  variante?: 'menu' | 'lista';
  class?: string;
}

const { lang, alternativas, variante = 'menu', class: classe = '' } = Astro.props;
const t = dicionario(lang);
const porIdioma = new Map(alternativas.map((a) => [a.lang, a.href]));

const opcoes = IDIOMAS.map((idioma) => ({
  idioma,
  href: porIdioma.get(idioma),
  nome: NOME_IDIOMA[idioma],
  ativo: idioma === lang,
})).filter((o) => o.href);
---

{
  variante === 'menu' ? (
    <details data-seletor-idioma class:list={['relative', classe]}>
      <summary
        class="flex h-9 cursor-pointer list-none items-center gap-1 rounded-full bg-nevoa
               pl-2 pr-1.5 transition-colors duration-200 hover:bg-nevoa-forte md:h-10"
      >
        <span class="sr-only">{`${t.nav.escolherIdioma}, ${NOME_IDIOMA[lang]}`}</span>
        <Bandeira idioma={lang} tamanho={22} />
        <Icone nome="chevron" tamanho={16} class="seta-idioma text-atlantico/70 transition-transform duration-200" />
      </summary>

      <div
        data-lista-idiomas
        class="absolute right-0 top-[calc(100%+0.5rem)] w-48 rounded-2xl border border-nevoa-forte
               bg-branco p-1.5 shadow-[0_14px_40px_rgba(18,58,69,0.14)]"
      >
        <ul role="list">
          {opcoes.map((opcao) => (
            <li>
              <a
                href={opcao.href}
                hreflang={opcao.idioma}
                lang={opcao.idioma}
                data-idioma={opcao.idioma}
                aria-current={opcao.ativo ? 'true' : undefined}
                class:list={[
                  'flex items-center gap-3 rounded-xl px-2.5 py-2.5 text-[0.95rem]',
                  'transition-colors duration-200',
                  opcao.ativo
                    ? 'bg-nevoa font-medium text-atlantico'
                    : 'text-pedra hover:bg-nevoa hover:text-atlantico',
                ]}
              >
                <Bandeira idioma={opcao.idioma} tamanho={22} />
                <span>{opcao.nome}</span>
                {opcao.ativo && <Icone nome="confere" tamanho={16} class="ml-auto text-atlantico" />}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </details>
  ) : (
    <details data-seletor-idioma class={classe}>
      <summary
        class="flex cursor-pointer list-none items-center gap-3 rounded-xl bg-nevoa px-2.5 py-2.5
               text-[0.95rem] font-medium text-atlantico transition-colors duration-200
               hover:bg-nevoa-forte"
      >
        <span class="sr-only">{`${t.nav.escolherIdioma}, `}</span>
        <Bandeira idioma={lang} tamanho={24} />
        <span>{NOME_IDIOMA[lang]}</span>
        <Icone nome="chevron" tamanho={16} class="seta-idioma ml-auto text-atlantico/70 transition-transform duration-200" />
      </summary>

      <ul role="list" data-lista-idiomas class="mt-0.5 flex flex-col gap-0.5">
        {opcoes
          .filter((opcao) => !opcao.ativo)
          .map((opcao) => (
            <li>
              <a
                href={opcao.href}
                hreflang={opcao.idioma}
                lang={opcao.idioma}
                data-idioma={opcao.idioma}
                class="flex items-center gap-3 rounded-xl px-2.5 py-2.5 text-[0.95rem] text-pedra
                       transition-colors duration-200 hover:bg-nevoa hover:text-atlantico"
              >
                <Bandeira idioma={opcao.idioma} tamanho={24} />
                <span>{opcao.nome}</span>
              </a>
            </li>
          ))}
      </ul>
    </details>
  )
}

<style>
  /* O Safari desenha o triangulo do summary por aqui, nao por list-style. */
  summary::-webkit-details-marker {
    display: none;
  }

  /* A seta aponta para cima enquanto a lista esta aberta. */
  details[open] > summary :global(.seta-idioma) {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    details[open] > [data-lista-idiomas] {
      animation: abrir-idiomas 0.18s var(--ease-suave);
    }
  }

  @keyframes abrir-idiomas {
    from {
      opacity: 0;
      transform: translateY(-0.35rem);
    }
  }
</style>

<script>
  // Guarda a escolha para a proxima visita a raiz do site.
  document.querySelectorAll<HTMLAnchorElement>('a[data-idioma]').forEach((link) => {
    link.addEventListener('click', () => {
      try {
        localStorage.setItem('idioma', link.dataset.idioma!);
      } catch {
        // Navegacao privada ou cookies bloqueados. O site funciona do mesmo jeito.
      }
    });
  });

  // O que o <details> nativo nao faz: fechar com Escape ou com um clique fora.
  const seletores = document.querySelectorAll<HTMLDetailsElement>('[data-seletor-idioma]');

  if (seletores.length > 0) {
    const fecharTodos = (menos?: HTMLDetailsElement) => {
      seletores.forEach((seletor) => {
        if (seletor !== menos) seletor.open = false;
      });
    };

    seletores.forEach((seletor) => {
      seletor.addEventListener('toggle', () => {
        if (seletor.open) fecharTodos(seletor);
      });
    });

    document.addEventListener('click', (evento) => {
      const alvo = evento.target as Node;
      seletores.forEach((seletor) => {
        if (seletor.open && !seletor.contains(alvo)) seletor.open = false;
      });
    });

    // Na fase de captura, para que o Escape feche so a lista de idiomas e nao
    // chegue ao painel lateral, que tambem fecha com Escape.
    document.addEventListener(
      'keydown',
      (evento) => {
        if (evento.key !== 'Escape') return;
        let fechou = false;
        seletores.forEach((seletor) => {
          if (!seletor.open) return;
          seletor.open = false;
          seletor.querySelector('summary')?.focus();
          fechou = true;
        });
        if (fechou) evento.stopPropagation();
      },
      true,
    );
  }
</script>
