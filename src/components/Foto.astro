---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Foto do site com espaco reservado.
 *
 * Usa <Picture> e nao <Image> porque o <Image> gera so WebP. Com AVIF na
 * frente, as mesmas fotos ficam de 20 a 30 por cento menores, o que conta em
 * um site com muita fotografia aberto no celular. O navegador escolhe: AVIF,
 * depois WebP, e jpg como ultimo recurso.
 *
 * Enquanto a Olivia nao enviar a imagem, o lugar dela nao fica vazio nem
 * quebrado: aparece um bloco em Nevoa com o simbolo da marca bem discreto.
 * Assim da para ver o site montado e a troca depois e so soltar o arquivo
 * na pasta certa (ver src/lib/imagens.ts).
 */
interface Props {
  src?: ImageMetadata | undefined;
  alt: string;
  /** Proporcao da moldura, no formato do CSS aspect-ratio. */
  proporcao?: string;
  /** Larguras candidatas para o srcset. */
  larguras?: number[];
  sizes?: string;
  /** Verdadeiro apenas para a imagem principal do hero. */
  prioridade?: boolean;
  class?: string;
  /**
   * Classe aplicada a propria imagem: efeitos de hover do cartao ou o recorte
   * (object-position) quando o assunto nao esta no centro, como no hero.
   */
  classeImagem?: string;
  /**
   * Cor do espaco reservado. 'escuro' e para areas com texto branco por cima,
   * como o hero: sem foto, um fundo claro deixaria o texto ilegivel.
   */
  reservado?: 'claro' | 'escuro';
}

const {
  src,
  alt,
  proporcao = '4 / 3',
  larguras = [400, 700, 1000, 1400],
  sizes = '(min-width: 768px) 33vw, 100vw',
  prioridade = false,
  class: classe = '',
  classeImagem = '',
  reservado = 'claro',
} = Astro.props;

const escuro = reservado === 'escuro';
const corReservado = escuro ? '#EEF2F0' : '#123A45';
---

<div
  class:list={['relative overflow-hidden', escuro ? 'bg-atlantico' : 'bg-nevoa', classe]}
  style={`aspect-ratio: ${proporcao};`}
>
  {
    src ? (
      <Picture
        src={src}
        alt={alt}
        widths={larguras}
        sizes={sizes}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        loading={prioridade ? 'eager' : 'lazy'}
        decoding={prioridade ? 'sync' : 'async'}
        fetchpriority={prioridade ? 'high' : 'auto'}
        pictureAttributes={{ class: 'block h-full w-full' }}
        class:list={['h-full w-full object-cover', classeImagem]}
      />
    ) : (
      <div class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
        <svg
          viewBox="0 0 120 120"
          class:list={['h-1/3 max-h-24 w-auto', escuro ? 'opacity-[0.14]' : 'opacity-[0.18]']}
          focusable="false"
        >
          <circle cx="40" cy="42" r="7" fill={corReservado} />
          <path
            d="M14 84 C 24 72, 34 70, 44 78 C 50 58, 60 32, 76 32 C 92 32, 100 58, 106 84"
            fill="none"
            stroke={corReservado}
            stroke-width="4"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path
            d="M22 94 q 6 -5 12 0 t 12 0 t 12 0 t 12 0 t 12 0 t 12 0"
            fill="none"
            stroke={corReservado}
            stroke-width="3"
            stroke-linecap="round"
          />
        </svg>
      </div>
    )
  }
</div>
