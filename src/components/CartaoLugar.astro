---
import Galeria from './Galeria.astro';
import { dicionario, type Idioma } from '~/i18n/config';
import { fotosLugar } from '~/lib/imagens';

/**
 * Cartao de um lugar que pode entrar no roteiro.
 *
 * Nao e um link: nenhum lugar tem pagina propria, porque eles nao sao passeios
 * vendidos separadamente e sim pecas que a Olivia usa para montar o tour.
 *
 * Quando o lugar tem mais de uma foto (favela.jpg, favela-2.jpg...), a moldura
 * vira uma galeria que desliza para o lado (ver Galeria.astro).
 */
interface Props {
  lang: Idioma;
  id: string;
  nome: string;
  resumo: string;
  /** Verdadeiro apenas para cartoes que aparecem logo no topo da pagina. */
  prioridade?: boolean;
}

const { lang, id, nome, resumo, prioridade = false } = Astro.props;
const t = dicionario(lang);

// Descricao de cada foto, pelo nome do arquivo. Sem ela, o nome do lugar faz as vezes.
const descricoes: Record<string, string | undefined> = t.fotos.lugares;
const fotos = fotosLugar(id).map((foto) => ({ ...foto, alt: descricoes[foto.nome] ?? nome }));
---

<article class="revelar group">
  <Galeria
    lang={lang}
    fotos={fotos}
    nome={nome}
    proporcao="4 / 3"
    prioridade={prioridade}
    sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw"
    classeImagem="transition-transform duration-700 ease-[cubic-bezier(0.2,0,0,1)] motion-safe:group-hover:scale-[1.04]"
  />

  <h3 class="mt-5 text-titulo-cartao text-atlantico">{nome}</h3>
  <p class="mt-2 text-sm leading-relaxed text-pedra">{resumo}</p>
</article>
