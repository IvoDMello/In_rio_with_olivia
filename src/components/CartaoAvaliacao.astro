---
import Icone from './Icone.astro';
import type { Avaliacao } from '~/data/reviews';
import { LOCALE_DATA, dicionario, type Idioma } from '~/i18n/config';

interface Props {
  avaliacao: Avaliacao;
  lang: Idioma;
}

const { avaliacao, lang } = Astro.props;
const t = dicionario(lang);

const data = new Date(avaliacao.data).toLocaleDateString(LOCALE_DATA[lang], {
  month: 'long',
  year: 'numeric',
});
---

<figure class="revelar flex h-full flex-col bg-branco p-7 md:p-8">
  <Icone nome="aspas" tamanho={26} class="text-sol" />

  <blockquote class="mt-5 flex-1">
    <p class="text-pretty leading-relaxed text-atlantico">{avaliacao.texto[lang]}</p>
  </blockquote>

  <figcaption class="mt-7 border-t border-nevoa pt-5">
    <div class="flex items-center gap-2">
      <div class="flex items-center gap-1 text-sol" aria-hidden="true">
        {Array.from({ length: avaliacao.nota }).map(() => <Icone nome="estrela" tamanho={14} />)}
      </div>
      <span class="text-xs font-semibold text-atlantico">
        <span class="sr-only">{t.avaliacoes.notaDe}: </span>{avaliacao.nota}/5
      </span>
    </div>

    <p class="mt-3 text-sm font-medium text-atlantico">{avaliacao.autor}</p>
    <p class="mt-0.5 text-xs text-pedra">
      {avaliacao.origem ? `${avaliacao.origem} · ` : ''}{data}
    </p>
  </figcaption>
</figure>
