---
import Icone from './Icone.astro';
import { CONTATO } from '~/config/site';
import { noIdioma, type Avaliacao } from '~/data/reviews';
import { LOCALE_DATA, dicionario, type Idioma } from '~/i18n/config';

/**
 * Cartao de um depoimento do TripAdvisor. Usado na Home, em grade de tres,
 * e na pagina de Depoimentos, em colunas. Fundo branco: funciona sobre Nevoa.
 */
interface Props {
  avaliacao: Avaliacao;
  lang: Idioma;
  class?: string;
}

const { avaliacao, lang, class: classe = '' } = Astro.props;
const t = dicionario(lang);

// A data fica em UTC de proposito. '2019-03-01' e meia-noite em UTC, que no
// fuso do Brasil ainda e 28 de fevereiro, e o cartao mostraria o mes errado.
const data = new Date(avaliacao.data).toLocaleDateString(LOCALE_DATA[lang], {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

const titulo = avaliacao.titulo ? noIdioma(avaliacao.titulo, lang) : '';
const texto = noIdioma(avaliacao.texto, lang);

const outroIdioma = Boolean(avaliacao.idioma) && avaliacao.idioma !== lang;

// Com uma versao por idioma, a desta pagina e traducao sempre que o viajante
// escreveu em outro idioma, e o cartao diz isso.
const traduzidoDe: Record<string, string | undefined> = t.avaliacoes.traduzidoDe;
const rotuloTraducao =
  outroIdioma && typeof avaliacao.texto !== 'string'
    ? (traduzidoDe[avaliacao.idioma!] ?? t.avaliacoes.traduzido)
    : '';

// Com uma string so, o original aparece sem traducao: marca o idioma do
// trecho para o leitor de tela pronunciar certo.
const langTrecho =
  outroIdioma && typeof avaliacao.texto === 'string' ? avaliacao.idioma : undefined;

const inicial = avaliacao.autor.trim().charAt(0).toLocaleUpperCase(LOCALE_DATA[lang]);

// Todo cartao tem o icone do TripAdvisor. Com o link da avaliacao, ele abre a
// avaliacao; sem ele, a pagina da Olivia no TripAdvisor, onde ela tambem esta.
const linkTripadvisor = avaliacao.url || CONTATO.tripadvisor;
const rotuloTripadvisor = avaliacao.url
  ? t.avaliacoes.lerDeAutor.replace('{nome}', avaliacao.autor)
  : t.nav.tripadvisor;

// Faixa de fotos: no maximo tres a vista. As classes ficam escritas por
// extenso para o Tailwind encontra-las no codigo.
const MAX_FOTOS = 3;
const totalFotos = avaliacao.fotos?.length ?? 0;
const fotosExtras = Math.max(0, totalFotos - MAX_FOTOS);
const classeColunasFotos =
  totalFotos >= 3 ? 'grid-cols-3' : totalFotos === 2 ? 'grid-cols-2' : 'grid-cols-1';
---

{/* Sem a classe revelar: no celular os cartoes sao slides de um carrossel, e
    cada slide apareceria vazio e depois surgiria ao entrar pelo lado. Quem
    revela e o carrossel inteiro (CarrosselAvaliacoes.astro). */}
<figure class:list={['flex flex-col bg-branco p-6 sm:p-7 md:p-8', classe]}>
  {/* Quem escreveu vem primeiro, como no TripAdvisor. O figcaption pode ser o
      primeiro filho do figure, entao a semantica continua a mesma. */}
  <figcaption class="flex items-center gap-3.5">
    <span
      class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-nevoa
             font-titulo text-lg text-atlantico"
      aria-hidden="true"
    >
      {inicial}
    </span>

    <span class="min-w-0 flex-1">
      <span class="block text-sm font-medium text-atlantico">{avaliacao.autor}</span>
      {
        avaliacao.origem && (
          <span class="mt-0.5 block text-xs text-pedra">{noIdioma(avaliacao.origem, lang)}</span>
        )
      }
    </span>

    {
      linkTripadvisor && (
        <a
          href={linkTripadvisor}
          target="_blank"
          rel="noopener"
          data-analytics="tripadvisor-avaliacao"
          aria-label={rotuloTripadvisor}
          title={t.avaliacoes.lerNoTripadvisor}
          class="-mr-2 flex h-10 w-10 shrink-0 items-center justify-center rounded-full
                 text-atlantico transition-colors duration-200 hover:bg-nevoa"
        >
          <Icone nome="tripadvisor" tamanho={22} />
        </a>
      )
    }
  </figcaption>

  {/* A nota nao aparece escrita (as estrelas ja dizem), mas o leitor de tela
      precisa dela, porque as estrelas sao so desenho. */}
  <div class="mt-5 flex items-center gap-1 text-sol">
    {Array.from({ length: avaliacao.nota }).map(() => <Icone nome="estrela" tamanho={15} />)}
    <span class="sr-only">{t.avaliacoes.notaDe}: {avaliacao.nota}/5</span>
  </div>

  {
    avaliacao.fotos && avaliacao.fotos.length > 0 && (
      <div class="mt-5" data-photo-gallery>
        {/* Faixa de fotos sempre igual: mesma altura em todos os cartoes e a
            largura toda, com uma, duas ou tres colunas. A partir da quarta, as
            fotos ficam escondidas e a terceira mostra "+N"; o visualizador
            continua passando por todas, porque os botoes escondidos seguem na
            lista dele. Antes era uma fileira que rolava para o lado, com barra
            de rolagem aparente no Windows e largura diferente em cada cartao. */}
        <ul
          class:list={['grid gap-2', classeColunasFotos]}
          aria-label={lang === 'pt' ? 'Fotos do viajante' : lang === 'es' ? 'Fotos del viajero' : 'Traveler photos'}
        >
          {avaliacao.fotos.map((foto, i) => (
            <li class:list={['relative min-w-0 overflow-hidden rounded-sm bg-nevoa', i >= MAX_FOTOS && 'hidden']}>
              <button
                type="button"
                class="relative block w-full cursor-zoom-in focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sol"
                data-photo-open
                data-src={foto.src}
                data-alt={noIdioma(foto.alt, lang)}
                aria-label={lang === 'pt' ? `Ampliar foto: ${noIdioma(foto.alt, lang)}` : lang === 'es' ? `Ampliar foto: ${noIdioma(foto.alt, lang)}` : `Enlarge photo: ${noIdioma(foto.alt, lang)}`}
              >
                <img
                  src={foto.src}
                  alt={noIdioma(foto.alt, lang)}
                  loading="lazy"
                  decoding="async"
                  class="h-24 w-full object-cover transition-transform duration-300 hover:scale-[1.04] sm:h-28"
                />
                {
                  i === MAX_FOTOS - 1 && fotosExtras > 0 && (
                    <span
                      class="pointer-events-none absolute inset-0 flex items-center justify-center
                             bg-atlantico/55 text-lg font-medium text-branco"
                      aria-hidden="true"
                    >
                      +{fotosExtras}
                    </span>
                  )
                }
              </button>
            </li>
          ))}
        </ul>
        <dialog
          class="m-auto max-h-[94dvh] w-[min(94vw,72rem)] max-w-[94vw] overflow-visible bg-transparent p-0 backdrop:bg-atlantico/90"
          data-photo-dialog
          aria-label={lang === 'pt' ? 'Foto ampliada' : lang === 'es' ? 'Foto ampliada' : 'Enlarged photo'}
        >
          <button
            type="button"
            class="absolute right-3 top-3 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-branco text-2xl leading-none text-atlantico shadow-lg"
            data-photo-close
            aria-label={lang === 'pt' ? 'Fechar foto' : lang === 'es' ? 'Cerrar foto' : 'Close photo'}
          >
            ×
          </button>
          <div class="flex h-[min(76dvh,52rem)] w-full items-center justify-center">
            <img
              data-photo-large
              alt=""
              class="max-h-full max-w-full rounded-sm object-contain shadow-2xl transition-[opacity,transform] duration-300 ease-out"
            />
          </div>
          <div
            class="mt-4 grid w-full grid-cols-3 items-center justify-items-center"
            role="group"
            aria-label={lang === 'pt' ? 'Navegação das fotos' : lang === 'es' ? 'Navegación de fotos' : 'Photo navigation'}
          >
            <button
              type="button"
              class="flex h-10 w-10 items-center justify-center rounded-full bg-branco/95 text-2xl leading-none text-atlantico shadow-lg transition hover:scale-105 hover:bg-branco focus-visible:outline-2 focus-visible:outline-sol"
              data-photo-prev
              aria-label={lang === 'pt' ? 'Foto anterior' : lang === 'es' ? 'Foto anterior' : 'Previous photo'}
            >‹</button>
            <span data-photo-count class="min-w-12 text-center text-sm tabular-nums text-branco" aria-live="polite"></span>
            <button
              type="button"
              class="flex h-10 w-10 items-center justify-center rounded-full bg-branco/95 text-2xl leading-none text-atlantico shadow-lg transition hover:scale-105 hover:bg-branco focus-visible:outline-2 focus-visible:outline-sol"
              data-photo-next
              aria-label={lang === 'pt' ? 'Próxima foto' : lang === 'es' ? 'Foto siguiente' : 'Next photo'}
            >›</button>
          </div>
        </dialog>
      </div>
    )
  }

  <div class="mt-6 flex-1">
    <blockquote lang={langTrecho}>
      {
        titulo && (
          <p class="font-titulo text-titulo-cartao text-pretty text-atlantico">{titulo}</p>
        )
      }
      {/* O script recolhe os textos longos em 8 linhas, em qualquer tela: e o
          que deixa os cartoes com a mesma altura. Sem JavaScript o texto
          aparece inteiro, porque o recorte depende do atributo data-recolhido,
          que so o script coloca. */}
      <p
        class:list={[
          'whitespace-pre-line text-pretty text-[0.95rem] leading-relaxed text-atlantico',
          'data-[recolhido]:line-clamp-8',
          titulo && 'mt-3',
        ]}
        data-texto-avaliacao
      >
        {texto}
      </p>
    </blockquote>

    <button
      type="button"
      class="mt-3 self-start text-sm font-medium text-atlantico underline decoration-sol
             decoration-2 underline-offset-4"
      aria-expanded="false"
      data-ler-mais
      data-mais={t.avaliacoes.lerMais}
      data-menos={t.avaliacoes.lerMenos}
      hidden
    >
      {t.avaliacoes.lerMais}
    </button>

    {rotuloTraducao && <p class="mt-4 text-xs text-pedra">{rotuloTraducao}</p>}
  </div>

  <div class="mt-7 border-t border-nevoa pt-5">
    <time datetime={avaliacao.data.slice(0, 7)} class="text-xs text-pedra">{data}</time>
  </div>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-photo-gallery]').forEach((gallery) => {
    const dialog = gallery.querySelector<HTMLDialogElement>('[data-photo-dialog]');
    const largeImage = gallery.querySelector<HTMLImageElement>('[data-photo-large]');
    const photoCount = gallery.querySelector<HTMLElement>('[data-photo-count]');
    if (!dialog || !largeImage) return;

    const photoButtons = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-photo-open]'));
    let activeIndex = 0;
    let transitionTimer = 0;

    const showPhoto = (index: number, direction: -1 | 1 = 1) => {
      activeIndex = (index + photoButtons.length) % photoButtons.length;
      const button = photoButtons[activeIndex];
      window.clearTimeout(transitionTimer);
      largeImage.classList.add('opacity-0', direction > 0 ? 'translate-x-3' : '-translate-x-3');
      transitionTimer = window.setTimeout(() => {
        largeImage.src = button.dataset.src ?? '';
        largeImage.alt = button.dataset.alt ?? '';
        if (photoCount) photoCount.textContent = `${activeIndex + 1} / ${photoButtons.length}`;
        largeImage.onload = () => {
          largeImage.classList.remove('opacity-0', 'translate-x-3', '-translate-x-3');
        };
        if (largeImage.complete) {
          largeImage.classList.remove('opacity-0', 'translate-x-3', '-translate-x-3');
        }
      }, 140);
    };

    photoButtons.forEach((button, index) => {
      button.addEventListener('click', () => {
        activeIndex = index;
        largeImage.classList.remove('opacity-0', 'translate-x-3', '-translate-x-3');
        largeImage.src = button.dataset.src ?? '';
        largeImage.alt = button.dataset.alt ?? '';
        if (photoCount) photoCount.textContent = `${activeIndex + 1} / ${photoButtons.length}`;
        dialog.showModal();
      });
    });

    gallery.querySelector('[data-photo-prev]')?.addEventListener('click', () => showPhoto(activeIndex - 1, -1));
    gallery.querySelector('[data-photo-next]')?.addEventListener('click', () => showPhoto(activeIndex + 1, 1));
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft' && gallery.querySelector('[data-photo-prev]')) showPhoto(activeIndex - 1, -1);
      if (event.key === 'ArrowRight' && gallery.querySelector('[data-photo-next]')) showPhoto(activeIndex + 1, 1);
    });

    gallery.querySelector('[data-photo-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });

  // "Ler mais". O botao so aparece quando o texto de fato passa das 8 linhas
  // na largura atual. Recalcula quando a largura muda e quando as fontes
  // terminam de carregar, porque as duas coisas mudam a quebra das linhas.
  const prepararTextos = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-ler-mais]').forEach((botao) => {
      const texto = botao.closest('figure')?.querySelector<HTMLElement>('[data-texto-avaliacao]');
      if (!texto || botao.getAttribute('aria-expanded') === 'true') return;

      texto.dataset.recolhido = '';
      const transborda = texto.scrollHeight > texto.clientHeight + 1;
      botao.hidden = !transborda;
      if (!transborda) delete texto.dataset.recolhido;
    });
  };

  document.querySelectorAll<HTMLButtonElement>('[data-ler-mais]').forEach((botao) => {
    botao.addEventListener('click', () => {
      const texto = botao.closest('figure')?.querySelector<HTMLElement>('[data-texto-avaliacao]');
      if (!texto) return;
      const abrir = botao.getAttribute('aria-expanded') !== 'true';
      if (abrir) delete texto.dataset.recolhido;
      else texto.dataset.recolhido = '';
      botao.setAttribute('aria-expanded', String(abrir));
      botao.textContent = (abrir ? botao.dataset.menos : botao.dataset.mais) ?? '';
    });
  });

  prepararTextos();
  document.fonts?.ready.then(prepararTextos);

  let larguraAnterior = window.innerWidth;
  let esperaRedimensionar = 0;
  window.addEventListener('resize', () => {
    // No celular, a barra do navegador some e aparece ao rolar e dispara
    // resize so com mudanca de altura. Isso nao muda as linhas.
    if (window.innerWidth === larguraAnterior) return;
    larguraAnterior = window.innerWidth;
    window.clearTimeout(esperaRedimensionar);
    esperaRedimensionar = window.setTimeout(prepararTextos, 150);
  });
</script>
